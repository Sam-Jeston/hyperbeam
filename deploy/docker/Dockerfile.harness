# syntax=docker/dockerfile:1
# Harness images: one coding agent that speaks the Agent Client Protocol, on
# a base with git and Node.js. Hyperbeam adds its runner at start-up.
#
#   docker build -f deploy/docker/Dockerfile.harness --target claude-code -t hyperbeam/harness-claude-code .
#
# The agent lives under /opt/harness and depends on nothing outside it but
# glibc. That lets a sandbox run in an *environment*, an image holding your
# toolchains, with the agent carried in from here: see docs/content/environments.md.
# For your own tools, prefer an environment to adding them to this image.

FROM node:22-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq less openssh-client patch procps ripgrep unzip \
    && rm -rf /var/lib/apt/lists/* \
    # Sandboxes run as uid 1000 with a writable /home/agent and /workspace.
    && mkdir -p /home/agent /workspace && chown 1000:1000 /home/agent /workspace \
    # The agent's own Node.js, apart from the one on the PATH.
    && mkdir -p /opt/harness/bin /opt/harness/libexec && cp /usr/local/bin/node /opt/harness/libexec/node
COPY deploy/docker/harness-install /usr/local/bin/harness-install
ENV HOME=/home/agent \
    PATH=/opt/harness/bin:$PATH \
    # Honour HTTPS_PROXY (Hyperbeam's egress allowlist) in Node's own fetch.
    NODE_USE_ENV_PROXY=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
USER 1000
WORKDIR /workspace

FROM base AS claude-code
USER root
RUN harness-install @agentclientprotocol/claude-agent-acp
USER 1000

FROM base AS codex
USER root
RUN harness-install @agentclientprotocol/codex-acp @openai/codex
USER 1000

FROM base AS gemini
USER root
RUN harness-install @google/gemini-cli
USER 1000

FROM base AS opencode
USER root
RUN harness-install opencode-ai
USER 1000
